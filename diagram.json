    ["pot1:SIG", "esp:34", "green", []],
    ["esp:18", "r1:1", "green", []],
    ["r1:2", "led1:A", "green", []],
    ["led1:C", "esp:GND.2", "black", []]
  ],
  "dependencies": {},
  "serialMonitor": {
    "display": "always"
