    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": -20,
      "left": 250,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 150,
      "left": 260,
      "attrs": {
        "color": "red"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
